{
  "name": "habbo-sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for the public Habbo API and the Wired Variables API.",
  "license": "MIT",
  "author": {
    "name": "Michael Araque (cebolla1)",
    "url": "https://github.com/michyaraque"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michyaraque/habbo-sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx test/level-upper.test.ts && tsx test/variables.test.ts && tsx test/public.test.ts",
    "example:profiles": "tsx examples/profiles.ts",
    "example:variables": "tsx examples/variables.ts",
    "example:origins": "tsx examples/origins.ts",
    "docs": "typedoc",
    "docs:serve": "npx --yes http-server docs -p 8080 -c-1"
  },
  "keywords": [
    "habbo",
    "habbo-sdk",
    "wired",
    "api",
    "typescript"
  ],
  "dependencies": {
    "json-with-bigint": "^3.5.12"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.7.2"
  }
}